# --- Required ---
# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Postgres with the pgvector extension.
# Local (docker compose up -d):  postgres://docuchat:docuchat@localhost:5432/docuchat
# Hosted: a free Neon database (https://neon.tech) works out of the box.
DATABASE_URL=

# --- Optional ---
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# RETRIEVAL_TOP_K=6
# NEXT_PUBLIC_REPO_URL=https://github.com/your-name/docuchat

# Public-demo guardrails (keep your Gemini bill bounded)
# MAX_FILE_MB=4
# MAX_PDF_PAGES=60
# MAX_DOCS_PER_WORKSPACE=5
# UPLOADS_PER_IP_PER_DAY=10
# QUESTIONS_PER_IP_PER_DAY=40
# WORKSPACE_TTL_HOURS=24
